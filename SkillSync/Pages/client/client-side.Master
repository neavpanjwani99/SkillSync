<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="client-side.Master.cs" Inherits="SkillSync.Site1" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillSync | Requirement-Based Freelancer Marketplace</title>
    
    <!-- Global StyleSheet -->
    <link href="~/css/StyleSheet1.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

<form id="form1" runat="server">

    <!-- ================= HEADER / NAVBAR ================= -->
    <header class="main-header">
        <div class="container nav-container">
            
            <!-- LOGO -->
            <div class="brand-logo">
                <asp:HyperLink ID="LogoLink" runat="server" NavigateUrl="~/Pages/client/Home.aspx">
                    <asp:Image ID="MainLogo" runat="server" ImageUrl="~/images/main-logo.png" AlternateText="SkillSync Logo" />
                </asp:HyperLink>
            </div>

            <!-- NAVIGATION LINKS -->
            <nav class="nav-links">
                <asp:HyperLink ID="HomeLink" runat="server" NavigateUrl="~/Pages/client/Home.aspx" CssClass="nav-link">
                    Home
                </asp:HyperLink>

                <asp:HyperLink ID="FindLink" runat="server" NavigateUrl="~/Pages/client/FindFreelancer.aspx" CssClass="nav-link">
                    Find Freelancer
                </asp:HyperLink>

                <asp:HyperLink ID="MatchLink" runat="server" NavigateUrl="~/Pages/client/MatchResults.aspx" CssClass="nav-link">
                    Match Results
                </asp:HyperLink>

                <asp:HyperLink ID="CompareLink" runat="server" NavigateUrl="~/Pages/client/Compare.aspx" CssClass="nav-link">
                    Compare
                </asp:HyperLink>

                <asp:HyperLink ID="LoginLink" runat="server" NavigateUrl="#" CssClass="btn-primary">
                    Login
                </asp:HyperLink>
            </nav>

        </div>
    </header>

    <!-- ================= MAIN CONTENT PLACEHOLDER ================= -->
    <main class="main-content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-grid">
                <!-- BRAND BRIEF -->
                <div class="footer-brand">
                    <h3>SkillSync</h3>
                    <p>Requirement-based freelancer discovery and comparison platform. Match your project needs with top freelancers efficiently.</p>
                </div>

                <!-- NAVIGATION -->
                <div class="footer-column">
                    <h4>Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="Home.aspx">Home</a></li>
                        <li><a href="FindFreelancer.aspx">Find Freelancer</a></li>
                        <li><a href="MatchResults.aspx">Match Results</a></li>
                        <li><a href="Compare.aspx">Compare Freelancers</a></li>
                    </ul>
                </div>

                <!-- POPULAR CATEGORIES -->
                <div class="footer-column">
                    <h4>Categories</h4>
                    <ul class="footer-links">
                        <li><a href="FindFreelancer.aspx">Web Development</a></li>
                        <li><a href="FindFreelancer.aspx">UI/UX Design</a></li>
                        <li><a href="FindFreelancer.aspx">Graphic Design</a></li>
                        <li><a href="FindFreelancer.aspx">Digital Marketing</a></li>
                    </ul>
                </div>

                <!-- CONTACT & ABOUT -->
                <div class="footer-column">
                    <h4>Platform</h4>
                    <ul class="footer-links">
                        <li><a href="#">About SkillSync</a></li>
                        <li><a href="#">How It Works</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Support</a></li>
                    </ul>
                </div>
            </div>

            <!-- FOOTER BOTTOM -->
            <div class="footer-bottom">
                <p>© 2026 SkillSync Marketplace. Built for Academic Demonstration.</p>
                <p>Designed with CollegeHunt UI Inspiration</p>
            </div>
        </div>
    </footer>

</form>

</body>
</html>