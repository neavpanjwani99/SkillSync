<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="client-side.Master.cs" Inherits="SkillSync.Site1" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillSync | Requirement-Based Freelancer Marketplace</title>
    
    <!-- Global StyleSheet -->
    <link href="~/css/StyleSheet1.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

<form id="form1" runat="server">

    <!-- ================= HEADER / NAVBAR ================= -->
    <header class="main-header">
        <div class="container nav-container">
            
            <!-- LOGO -->
            <div class="brand-logo">
                <asp:HyperLink ID="LogoLink" runat="server" NavigateUrl="~/Pages/client/Home.aspx">
                    <asp:Image ID="MainLogo" runat="server" ImageUrl="~/images/main-logo.png" AlternateText="SkillSync Logo" />
                </asp:HyperLink>
            </div>

            <!-- NAVIGATION LINKS -->
            <nav class="nav-links">
                <asp:HyperLink ID="HomeLink" runat="server" NavigateUrl="~/Pages/client/Home.aspx" CssClass="nav-link">
                    Home
                </asp:HyperLink>

                <asp:HyperLink ID="FindLink" runat="server" NavigateUrl="~/Pages/client/FindFreelancer.aspx" CssClass="nav-link">
                    Find Freelancer
                </asp:HyperLink>

                <asp:HyperLink ID="MatchLink" runat="server" NavigateUrl="~/Pages/client/MatchResults.aspx" CssClass="nav-link">
                    Match Results
                </asp:HyperLink>

                <asp:HyperLink ID="CompareLink" runat="server" NavigateUrl="~/Pages/client/Compare.aspx" CssClass="nav-link">
                    Compare
                </asp:HyperLink>

                <asp:HyperLink ID="LoginLink" runat="server" NavigateUrl="#" CssClass="btn-primary">
                    Login
                </asp:HyperLink>
            </nav>

        </div>
    </header>

    <!-- ================= MAIN CONTENT PLACEHOLDER ================= -->
    <main class="main-content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>

    <!-- ================= FOOTER (CollegeHunt Inspired) ================= -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-grid">
                
                <!-- BRAND CARD & LOGO -->
                <div class="footer-brand">
                    <div class="footer-brand-logo-card">
                        <asp:HyperLink ID="FooterLogoLink" runat="server" NavigateUrl="~/Pages/client/Home.aspx">
                            <asp:Image ID="FooterLogo" runat="server" ImageUrl="~/images/main-logo.png" AlternateText="SkillSync Brand Logo" />
                        </asp:HyperLink>
                    </div>

                    <div class="footer-tagline">Skills Meet Opportunities</div>

                    <p class="footer-brand-desc">
                        SkillSync is a requirement-based freelancer discovery &amp; comparison platform. 
                        Enter your project requirements, view match percentages, and choose the right talent.
                    </p>

                    <div class="footer-pills">
                        <span class="footer-pill">🎯 Smart Matching</span>
                        <span class="footer-pill">⚖️ Side-by-Side Compare</span>
                        <span class="footer-pill">📍 Location &amp; Work Mode</span>
                    </div>
                </div>

                <!-- QUICK LINKS -->
                <div class="footer-column">
                    <h4>Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="Home.aspx"><span>→</span> Home</a></li>
                        <li><a href="FindFreelancer.aspx"><span>→</span> Find Freelancer</a></li>
                        <li><a href="MatchResults.aspx"><span>→</span> Match Results</a></li>
                        <li><a href="Compare.aspx"><span>→</span> Compare Freelancers</a></li>
                        <li><a href="../admin/AdminDashboard.aspx"><span>→</span> Admin Portal</a></li>
                    </ul>
                </div>

                <!-- TOP CATEGORIES -->
                <div class="footer-column">
                    <h4>Categories</h4>
                    <ul class="footer-links">
                        <li><a href="FindFreelancer.aspx"><span>→</span> Web Development</a></li>
                        <li><a href="FindFreelancer.aspx"><span>→</span> UI/UX Design</a></li>
                        <li><a href="FindFreelancer.aspx"><span>→</span> Graphic Design</a></li>
                        <li><a href="FindFreelancer.aspx"><span>→</span> Digital Marketing</a></li>
                        <li><a href="FindFreelancer.aspx"><span>→</span> Content Writing</a></li>
                    </ul>
                </div>

                <!-- PLATFORM & ABOUT -->
                <div class="footer-column">
                    <h4>Platform</h4>
                    <ul class="footer-links">
                        <li><a href="#"><span>→</span> How Matching Works</a></li>
                        <li><a href="#"><span>→</span> Freelancer Verification</a></li>
                        <li><a href="#"><span>→</span> Terms of Service</a></li>
                        <li><a href="#"><span>→</span> Privacy Policy</a></li>
                        <li><a href="#"><span>→</span> Support &amp; FAQ</a></li>
                    </ul>
                </div>

            </div>

            <!-- FOOTER BOTTOM -->
            <div class="footer-bottom">
                <p>© 2026 SkillSync Freelancer Marketplace. All Rights Reserved.</p>
                <div class="footer-bottom-badge">
                    College Project Prototype | ASP.NET Web Forms
                </div>
            </div>
        </div>
    </footer>

</form>

</body>
</html>