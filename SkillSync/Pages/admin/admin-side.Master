<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admin-side.Master.cs" Inherits="SkillSync.Pages.admin.admin_side" %><!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillSync | Admin Panel</title>
    <link href="../../css/StyleSheet1.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
            background-color: #f5f0eb;
        }

        .admin-sidebar {
            width: 250px;
            background-color: #2B1A12;
            color: #FFFAF3;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            float: left;
            min-height: 100vh;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.08);
        }

        .admin-brand {
            padding: 24px 20px;
            border-bottom: 1px solid #4B3529;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-brand h2 {
            color: #F3E2CF;
            font-size: 20px;
            margin: 0;
        }

        .admin-badge {
            background-color: #C99A5B;
            color: #2B1A12;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .admin-menu {
            list-style: none;
            padding: 20px 0;
            margin: 0;
            flex: 1;
        }

        .admin-menu-item {
            margin-bottom: 4px;
        }

        .admin-menu-link {
            display: block;
            padding: 14px 24px;
            color: #D9C6B5;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .admin-menu-link:hover, .admin-menu-link.active {
            background-color: #5A321F;
            color: #FFFAF3;
            border-left: 4px solid #C99A5B;
        }

        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .admin-topbar {
            background-color: #FFFFFF;
            height: 70px;
            border-bottom: 1px solid #E5D6C5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            box-shadow: 0 2px 10px rgba(43, 26, 18, 0.04);
        }

        .admin-topbar-title {
            font-size: 18px;
            font-weight: 700;
            color: #2B1A12;
            display: inline-block;
            float: left;
        }

        .admin-container {
            padding: 32px;
            flex: 1;
        }

        .admin-footer {
            padding: 20px 32px;
            background-color: #FFFFFF;
            border-top: 1px solid #E5D6C5;
            text-align: center;
            font-size: 13px;
            color: #7A685D;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
<form id="form1" runat="server">

    <div class="admin-wrapper">
        <!-- SIDEBAR (LEFT) -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <h2>SkillSync</h2>
                <span class="admin-badge">Admin</span>
            </div>

            <ul class="admin-menu">
                <li class="admin-menu-item">
                    <asp:HyperLink ID="NavDashboard" runat="server" NavigateUrl="~/Pages/admin/AdminDashboard.aspx" CssClass="admin-menu-link">Dashboard Overview</asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="NavUsers" runat="server" NavigateUrl="~/Pages/admin/ManageUsers.aspx" CssClass="admin-menu-link">Manage Users</asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="NavServices" runat="server" NavigateUrl="~/Pages/admin/ManageServices.aspx" CssClass="admin-menu-link">Manage Services</asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="NavOrders" runat="server" NavigateUrl="~/Pages/admin/ManageOrders.aspx" CssClass="admin-menu-link">Manage Orders</asp:HyperLink>
                </li>
                <li class="admin-menu-item" style="margin-top: 30px; border-top: 1px solid #4B3529; padding-top: 10px;">
                    <asp:HyperLink ID="NavClientSite" runat="server" NavigateUrl="~/Pages/client/Home.aspx" CssClass="admin-menu-link">Client Portal</asp:HyperLink>
                </li>
            </ul>
        </aside>

        <!-- MAIN CONTENT (RIGHT) -->
        <div class="admin-main">
            <!-- TOPBAR -->
            <header class="admin-topbar">
                <div class="admin-topbar-title">Marketplace Administration</div>
                <div>
                    <span style="font-size: 14px; font-weight: 600; color: #4A2C1D;">Administrator Mode</span>
                </div>
            </header>

            <!-- CONTENT PLACEHOLDER -->
            <main class="admin-container">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>

            <!-- FOOTER -->
            <footer class="admin-footer">
                &copy; 2026 SkillSync Admin Portal. Internal Management Console.
            </footer>
        </div>
        <div style="clear: both;"></div>
    </div>

</form>
</body>
</html>
